# circle-pro-api — environment

# HTTP
PORT=8789

# Postgres (Prisma). Local dev via docker compose (see docker-compose.yml):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/circle_pro
# Production: swap for the Neon connection string — no code change.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/circle_pro

# Privy (server-side JWT verification). App id + secret from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Comma-separated allowed origins for CORS (the circle-pro-mvp front).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Dev testing ONLY — when set, enables POST /dev/seed-profile and header-based
# wallet impersonation (x-dev-token + x-dev-wallet) so the API is curl-testable
# without Privy. MUST be empty in production.
DEV_SEED_TOKEN=
