# group-api — environment

# HTTP
PORT=8788

# Postgres (Prisma). Local dev example:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/group_api
DATABASE_URL=

# Privy (server-side JWT verification). App id + secret from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Ably (realtime notifications). A root API key; the service issues scoped
# token requests to clients via GET /ably/token.
ABLY_API_KEY=

# Intuition indexer (owner identity = group atom creator). Defaults to mainnet.
INTUITION_GRAPHQL_URL=https://mainnet.intuition.sh/v1/graphql

# Comma-separated allowed origins for CORS (the explorer). Example:
#   CORS_ORIGINS=http://localhost:5173,https://explorer.intuition.systems
CORS_ORIGINS=http://localhost:5173

# Dev testing ONLY — when set, enables POST /dev/seed-owner and header-based
# wallet impersonation (x-dev-token + x-dev-wallet) so the API is curl-testable
# without Privy / on-chain groups. MUST be empty in production.
DEV_SEED_TOKEN=
