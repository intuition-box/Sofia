# reputation-api configuration

# Postgres (Neon) connection string — its own DB, separate from group-api.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Intuition indexer (GraphQL read endpoint). Defaults to mainnet.
INTUITION_GRAPHQL_URL=https://mainnet.intuition.sh/v1/graphql

# MCP trust engine base URL. The job POSTs to ${MCP_TRUST_URL}/mcp.
MCP_TRUST_URL=https://mcp-trust.intuition.box

# Shared secret guarding POST /internal/leaderboard/compute (the cron trigger).
# Unset ⇒ the compute endpoint 404s; GET /leaderboard stays public.
LEADERBOARD_COMPUTE_TOKEN=

# Comma-separated allowed CORS origins (the explorer).
CORS_ORIGINS=http://localhost:5173

# HTTP port (Coolify sets this).
PORT=8790
