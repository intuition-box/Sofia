# Sofia Mastra — environment variables
# Copy to `.env` and fill in. Never commit secrets.
#
# NOTE : ce service est l'API OAuth + attestation on-chain. PLUS d'IA
# (GaiaNet retiré) et PLUS de MCP embarqué (l'explorer consomme le MCP
# distant). Aucune var GaiaNet/MCP n'est nécessaire.

# ── Storage ────────────────────────────────────────────────────────────
# Local libSQL file (default). En prod = volume DStack chiffré.
DATABASE_URL=file:./data/mastra.db

# ── On-chain bot (Human Attestor) ──────────────────────────────────────
# Clé privée du wallet bot qui paie atom/triple dans link-social-workflow
# + social-verifier-workflow. Sa CLÉ + son ADRESSE comptent : l'adresse est
# hardcodée en BOT_VERIFIER_ADDRESS dans l'extension (à MAJ si rotation).
BOT_PRIVATE_KEY=

# Override optionnel du RPC mainnet Intuition (défaut en dur dans le code).
# RPC_URL=https://rpc.intuition.systems

# ── OAuth token encryption ─────────────────────────────────────────────
# 64-char hex (32 bytes) pour AES-256-GCM. Générer :  openssl rand -hex 32
# Si vide : stockage oauth_tokens désactivé (warning au boot).
TOKEN_ENCRYPTION_KEY=

# ── OAuth provider credentials ─────────────────────────────────────────
# Redirect URI attendu :  {VITE_MASTRA_URL}/oauth/{platformId}/callback
# Détails par provider : docs/credentials-oauth-phase-1.md.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
MIXCLOUD_CLIENT_ID=
MIXCLOUD_CLIENT_SECRET=
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# ── Signal fetcher API keys ────────────────────────────────────────────
GRAPH_API_KEY=
NEYNAR_API_KEY=
OPENSEA_API_KEY=
# RPC Ethereum privé (sinon défaut public rate-limité)
ETH_MAINNET_RPC=
