# ============================================================================
# Sofia Contracts — Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ============================================================================

# ---------- Deployer key ----------
# Private key of the EOA that will deploy contracts.
# For mainnet/testnet, this MUST be a dedicated deployer EOA — NOT the multisig.
# After deployment, ownership is transferred to the Safe multisig.
PRIVATE_KEY=0x...

# ---------- RPC endpoints ----------
# Defaults work, override only if using a custom RPC.
INTUITION_RPC_URL=https://rpc.intuition.systems
INTUITION_TESTNET_RPC_URL=https://testnet.rpc.intuition.systems

# ---------- Gas reporter ----------
REPORT_GAS=false

# ============================================================================
# Constructor parameters for CirclesFactory deployment
# ============================================================================

# ---------- Safe multisig (initial owner of CirclesFactory) ----------
# Mainnet: 0xf10D442D0fB934D4037DC30769a6EfCf2f54F7B6 (OnchainDen Safe 2-of-3)
SAFE_ADDRESS_MAINNET=0xf10D442D0fB934D4037DC30769a6EfCf2f54F7B6
SAFE_ADDRESS_TESTNET=

# ---------- TNS contracts ----------
# BaseRegistrar: ERC-721 contract holding .trust domain NFTs
TNS_BASE_REGISTRAR_MAINNET=0xc08c5b051a9cFbcd81584Ebb8870ed77eFc5E676
TNS_BASE_REGISTRAR_TESTNET=

# TNSRegistry: global node registry (equivalent of ENSRegistry)
# TODO: get from TNS founder Samoris
TNS_REGISTRY_MAINNET=
TNS_REGISTRY_TESTNET=

# Resolver: default resolver for .trust subdomains
# TODO: get from TNS founder Samoris
TNS_RESOLVER_MAINNET=
TNS_RESOLVER_TESTNET=

# Controller: for domain registration/renewal
# TODO: get from TNS founder Samoris
TNS_CONTROLLER_MAINNET=
TNS_CONTROLLER_TESTNET=

# ---------- IntuitionFeeProxyFactory (template — already deployed by template team) ----------
# https://github.com/.../intuition-fee-proxy-template
INTUITION_FEE_PROXY_FACTORY_MAINNET=
INTUITION_FEE_PROXY_FACTORY_TESTNET=

# ---------- Constants ----------
# namehash("circles.trust") — to be computed and pinned at deploy time
CIRCLES_NODE=
