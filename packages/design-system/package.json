{
  "name": "@0xsofia/design-system",
  "description": "Sofia design system — shared taxonomy, components, hooks, and styles across apps.",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./styles/bento.css": "./src/styles/bento.css",
    "./styles/favicon.css": "./src/styles/favicon.css",
    "./styles/feed-card.css": "./src/styles/feed-card.css",
    "./styles/verb-tag.css": "./src/styles/verb-tag.css",
    "./styles/topic-pill.css": "./src/styles/topic-pill.css",
    "./styles/user-badge.css": "./src/styles/user-badge.css",
    "./styles/interests.css": "./src/styles/interests.css",
    "./styles/nav-sidebar.css": "./src/styles/nav-sidebar.css",
    "./styles/app-shell.css": "./src/styles/app-shell.css",
    "./styles/page-hero.css": "./src/styles/page-hero.css",
    "./styles/section-title.css": "./src/styles/section-title.css",
    "./styles/interest-hero.css": "./src/styles/interest-hero.css",
    "./styles/sub-header.css": "./src/styles/sub-header.css",
    "./styles/topic-picker.css": "./src/styles/topic-picker.css",
    "./styles/niche-chips.css": "./src/styles/niche-chips.css",
    "./styles/platforms-grid.css": "./src/styles/platforms-grid.css",
    "./styles/section-h2.css": "./src/styles/section-h2.css",
    "./styles/echoes-sort-tabs.css": "./src/styles/echoes-sort-tabs.css",
    "./styles/typography.css": "./src/styles/typography.css",
    "./styles/icon.css": "./src/styles/icon.css",
    "./styles/avatar.css": "./src/styles/avatar.css",
    "./styles/state-pill.css": "./src/styles/state-pill.css",
    "./styles/avail.css": "./src/styles/avail.css",
    "./styles/module-head.css": "./src/styles/module-head.css",
    "./styles/toast.css": "./src/styles/toast.css",
    "./styles/contribution-calendar.css": "./src/styles/contribution-calendar.css",
    "./styles/treemap.css": "./src/styles/treemap.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "lucide-react": ">=0.487.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": ">=0.180.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": ">=0.180.0",
    "lucide-react": "^0.525.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
