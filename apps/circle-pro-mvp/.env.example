# circle-pro-mvp — environment. Copy to .env for local dev.

# Privy app id (web login + embedded wallet). Reuse the explorer's app, or set
# the dedicated pro-client app id here — it's the only value that changes.
VITE_PRIVY_APP_ID=

# Off-chain backend (circle-pro-api). Local: http://localhost:8789
VITE_CIRCLE_PRO_API_URL=http://localhost:8789

# OG preview proxy for bookmark thumbnails.
VITE_OG_PROXY_URL=https://preview.sofia.intuition.box

# Ethereum mainnet RPC for ENS reverse resolution. Empty → viem default RPC.
VITE_ETH_RPC_URL=
