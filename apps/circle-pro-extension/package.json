{
  "name": "circle-pro-extension",
  "displayName": "Sofia Pro — Share in Sofia",
  "version": "0.1.0",
  "private": true,
  "description": "Right-click any page or link → Share in Sofia. Qualify it with the Sofia taxonomy, frictionless.",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@0xsofia/taxonomy": "workspace:*",
