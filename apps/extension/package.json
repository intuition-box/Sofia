{
  "name": "extension",
  "displayName": "Sofia",
  "version": "1.2.1",
  "description": "Mark the web with one click. Your signals become collective intelligence — no one owns the data, not even us.",
  "author": "me",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --no-minify && node scripts/post-build.js",
    "typecheck": "bash scripts/typecheck.sh",
    "package": "plasmo package",
    "proxy": "bun sofia-proxy/server.ts",
    "generate-icons": "node scripts/generate-icons.js",
    "clear:channels": "tsx background/__test__/clear-channels.ts",
    "test:persistence": "pnpm clear:channels && tsx background/__test__/test-channel-persistence.ts",
    "test:messages": "tsx background/__test__/test-message-reception.ts",
    "test:all": "pnpm clear:channels && tsx background/__test__/test-channel-persistence.ts && tsx background/__test__/test-message-reception.ts"
  },
  "dependencies": {
    "@0xsofia/design-system": "workspace:*",
    "@0xsofia/graphql": "workspace:*",
    "@0xsofia/taxonomy": "workspace:*",
    "@0xsofia/quests": "workspace:*",
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@plasmohq/storage": "^1.15.0",
    "@tanstack/query-async-storage-persister": "^5.99.2",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-persist-client": "^5.99.2",
    "graphql": "^16.11.0",
    "lucide-react": "^0.525.0",
    "mipd": "^0.0.7",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "viem": "^2.33.1",
    "wagmi": "^2.16.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@parcel/config-default": "^2.15.4",
    "@parcel/packager-css": "^2.15.4",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@tanstack/query-core": "5.91.2"
  },
  "resolutions": {
    "@tanstack/query-core": "5.91.2"
  },
  "manifest": {
    "homepage_url": "https://sofia.intuition.box",
    "permissions": [
      "storage",
      "tabs",
      "sidePanel",
      "bookmarks",
      "identity",
      "offscreen",
      "scripting",
      "contextMenus"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "externally_connectable": {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:5174/*",
        "https://sofia.intuition.box/*"
      ]
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "action": {},
    "web_accessible_resources": [
      {
        "resources": [
          "public/spline-background.webm",
          "assets/*",
          "components/ui/*.png",
          "components/ui/quick_action/*.svg"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
